<policies>
  <inbound>
    <base />
    <set-backend-service backend-id="gpt-terra-pool" />
  </inbound>
  <backend>
    <forward-request
      buffer-request-body="true"
      fail-on-error-status-code="false"
      timeout="300" />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
